{
  "name": "donate.noisebridge.net",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "watchexec -r -w src/ -- bun src/server.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/webhook",
    "dev:checkout": "stripe trigger checkout.session.completed",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./jsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "stripe-setup": "bun ./scripts/stripe-setup.ts",
    "clean-up-test-data": "bun ./scripts/clean-up-test-data.ts",
    "generate-openscad-qr": "bun ./scripts/generate-openscad-qr.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@playwright/test": "^1.61.1",
    "@stripe/stripe-js": "^9.9.0",
    "@types/bmp-js": "^0.1.2",
    "@types/bun": "1.3.14",
    "@types/mjml": "^5.0.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ws": "^8.20.1",
    "fast-uri": "^3.1.2",
    "ajv": "^8.18.0",
    "lodash": "^4.18.0",
    "js-cookie": "^3.0.6",
    "picomatch": "^2.3.2",
    "@isaacs/brace-expansion": "^5.0.1",
    "brace-expansion": "^2.0.3",
    "minimatch": ">=10.2.1",
    "undici": ">=6.27.0",
    "js-yaml": ">=4.1.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/error": "^4.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@kitajs/fastify-html-plugin": "^4.2.1",
    "@kitajs/html": "^4.2.13",
    "bmp-js": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "mjml": "^5.4.0",
    "obscenity": "^0.4.6",
    "pino": "^9.14.0",
    "resend": "^6.17.2",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  }
}
