{
  "name": "donate.noisebridge.net",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "watchexec -r -w src/ -- bun src/server.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/webhook",
    "dev:checkout": "stripe trigger checkout.session.completed",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./jsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "stripe-setup": "bun ./scripts/stripe-setup.ts",
    "clean-up-test-data": "bun ./scripts/clean-up-test-data.ts",
    "generate-openscad-qr": "bun ./scripts/generate-openscad-qr.ts",
    "screenshot": "bun ./scripts/screenshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@stripe/stripe-js": "^10.2.1",
    "@types/bmp-js": "^0.1.2",
    "@types/bun": "1.4.4",
    "@types/mjml": "^5.4.2",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/error": "^4.2.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "bmp-js": "0.1.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "mjml": "^5.4.1",
    "obscenity": "^0.4.6",
    "pino": "^10.4.0",
    "resend": "^6.37.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  }
}
