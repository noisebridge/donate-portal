{
  "name": "donate.noisebridge.net",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "1.3.13"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/webhook",
    "dev:checkout": "stripe trigger checkout.session.completed",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./jsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "stripe-setup": "bun ./scripts/stripe-setup.ts",
    "clean-up-test-data": "bun ./scripts/clean-up-test-data.ts",
    "generate-openscad-qr": "bun ./scripts/generate-openscad-qr.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@playwright/test": "^1.59.1",
    "@stripe/stripe-js": "^9.3.0",
    "@types/bmp-js": "^0.1.2",
    "@types/bun": "~1.3.13",
    "@types/mjml": "^5.0.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.59.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/error": "^4.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@kitajs/fastify-html-plugin": "^4.2.1",
    "@kitajs/html": "^4.2.13",
    "bmp-js": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "mjml": "^5.1.0",
    "pino": "^9.14.0",
    "qrcode-svg": "1.1.0",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  }
}
