{
  "name": "donate.noisebridge.net",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/webhook",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./jsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "stripe-setup": "bun ./scripts/stripe-setup.ts",
    "clean-up-test-data": "bun ./scripts/clean-up-test-data.ts",
    "generate-openscad-qr": "bun ./scripts/generate-openscad-qr.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "^1.58.1",
    "@types/bmp-js": "^0.1.2",
    "@types/bun": "~1",
    "@types/mjml": "^4.7.4",
    "@types/ws": "^8.18.1",
    "playwright": "^1.58.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@kitajs/fastify-html-plugin": "^4.2.1",
    "@kitajs/html": "^4.2.12",
    "bmp-js": "0.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.2",
    "mjml": "^4.18.0",
    "pino": "^9.6.0",
    "qrcode-svg": "1.1.0",
    "resend": "^6.9.1",
    "stripe": "^20.3.0"
  }
}
