{
  "name": "donate.noisebridge.net",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "watchexec -r -w src/ -- bun src/server.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/webhook",
    "dev:checkout": "stripe trigger checkout.session.completed",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./jsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "stripe-setup": "bun ./scripts/stripe-setup.ts",
    "clean-up-test-data": "bun ./scripts/clean-up-test-data.ts",
    "generate-openscad-qr": "bun ./scripts/generate-openscad-qr.ts",
    "screenshot": "bun ./scripts/screenshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@playwright/test": "^1.63.0",
    "@stripe/stripe-js": "^9.16.0",
    "@types/bmp-js": "^0.1.2",
    "@types/bun": "1.4.2",
    "@types/mjml": "^5.0.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/error": "^4.2.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@kitajs/fastify-html-plugin": "^4.2.1",
    "@kitajs/html": "^4.2.13",
    "bmp-js": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "mjml": "^5.4.1",
    "obscenity": "^0.4.6",
    "pino": "^10.3.1",
    "resend": "^6.28.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  }
}
